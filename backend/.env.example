# Copy this file to backend/.env and fill it in.

# The domain you registered (no https://). Several: example.com,www.example.com
SITE_DOMAIN=

# Time zone used by the admin pages.
TIME_ZONE=Asia/Hong_Kong

# Leave empty: a secret key is generated automatically in backend/data/.secret_key
# DJANGO_SECRET_KEY=

# Where the database and photos are stored (default: backend/data)
# DATA_DIR=
